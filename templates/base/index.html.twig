<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>API Endpoints</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 2rem; background: #f9f9f9; }
        h1 { color: #333; }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        th, td { border: 1px solid #ccc; padding: 0.5rem; text-align: left; }
        th { background: #eee; }
        tr:hover { background: #f1f1f1; }
        code { background: #eee; padding: 2px 4px; border-radius: 3px; }
    </style>
</head>
<body>
    <h1>Список API эндпоинтов</h1>
    <table>
        <thead>
            <tr>
                <th>Метод</th>
                <th>Эндпоинт</th>
                <th>Описание</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>POST</td>
                <td>/api/create_user</td>
                <td>Создать нового пользователя (name, phone, password, optional role)</td>
            </tr>
            <tr>
                <td>GET</td>
                <td>/api/users/{id}</td>
                <td>Получить данные пользователя по ID</td>
            </tr>
            <tr>
                <td>POST</td>
                <td>/api/create_house</td>
                <td>Создать новый дом (spaciousness, line, optional bathroom, shower)</td>
            </tr>
            <tr>
                <td>GET</td>
                <td>/api/houses/{id}</td>
                <td>Получить данные дома по ID</td>
            </tr>
            <tr>
                <td>POST</td>
                <td>/api/create_application</td>
                <td>Создать заявку на дом (user_id, house_id)</td>
            </tr>
            <tr>
                <td>GET</td>
                <td>/api/applications/{id}</td>
                <td>Получить заявку по ID</td>
            </tr>
        </tbody>
    </table>
</body>
</html>
